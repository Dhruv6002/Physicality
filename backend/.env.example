# Copy to backend/.env for local development. Never commit populated .env files.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=physicality
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=

# Obtain these from the Razorpay Dashboard. Keep the secret server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set true only for local testing without real payments. Leave false in production.
ALLOW_MOCK_PAYMENTS=false